---
const links = [
  { href: '/about/', label: 'About', code: '01' },
  { href: '/blog/', label: 'Blog', code: '02' },
  { href: '/projects/', label: 'Projects', code: '03' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header" transition:persist>
  <nav class="container nav" aria-label="Main">
    <a href="/" class="brand" aria-label="Home">
      <span class="brand__bracket">[</span>
      <span class="brand__name glitch" data-text="J.SHIRLEY">J.SHIRLEY</span>
      <span class="brand__bracket">]</span>
    </a>
    <ul class="nav__links">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class:list={['nav__link', { 'is-active': isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>
              <span class="nav__code">{l.code}</span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // The header persists across page swaps, so refresh the active link on each navigation.
  function markActive() {
    const path = location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('.nav__link').forEach((a) => {
      const href = a.getAttribute('href') ?? '';
      const active = path === href || path.startsWith(href);
      a.classList.toggle('is-active', active);
      if (active) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }
  document.addEventListener('astro:page-load', markActive);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 5, 13, 0.82);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 43, 214, 0.25);
    box-shadow: 0 1px 0 rgba(0, 240, 255, 0.08);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.14em;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover {
    text-shadow: none;
  }
  .brand__bracket {
    color: var(--neon-magenta);
    text-shadow: var(--glow-magenta);
  }
  .nav__links {
    display: flex;
    gap: clamp(6px, 2.5vw, 28px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 6px 2px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
  }
  .nav__code {
    font-size: 0.7rem;
    color: var(--neon-magenta);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--neon-cyan);
    box-shadow: var(--glow-cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }
  .nav__link.is-active {
    color: #fff;
  }
  @media (max-width: 480px) {
    .nav__code {
      display: none;
    }
    .brand {
      font-size: 0.85rem;
      letter-spacing: 0.08em;
    }
    .nav__link {
      font-size: 0.78rem;
    }
  }
</style>
