---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { projects, type Status } from '../data/projects';

const statusLabel: Record<Status, { text: string; cls: string }> = {
  live: { text: '● live', cls: 'tag--green' },
  wip: { text: '◐ in progress', cls: 'tag--yellow' },
  complete: { text: '■ complete', cls: '' },
};

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<Base title="Projects" description="Selected projects by Johnathan Shirley: data, machine learning, and the web.">
  <PageHeader eyebrow="03 // builds" title="Projects">
    <p>A hand-picked set of things I've built or am building. Some are finished, some are still in the forge.</p>
  </PageHeader>

  <section class="container projects">
    {
      featured.map((p) => (
        <article class="feat panel">
          <div class="feat__bar" aria-hidden="true">
            <span>~/projects/{p.name.toLowerCase()}</span>
            <span>featured</span>
          </div>
          <div class="feat__body">
            <div class="feat__head">
              <span class:list={['tag', statusLabel[p.status].cls]}>{statusLabel[p.status].text}</span>
              <h2 class="feat__name">
                <span class="glitch neon neon--cyan" data-text={p.name}>
                  {p.name}
                </span>
              </h2>
              <p class="feat__summary">{p.summary}</p>
            </div>
            <ul class="feat__details">
              {p.details.map((d) => <li>{d}</li>)}
            </ul>
            <ul class="stack" aria-label="Tech used">
              {p.tech.map((t) => <li class="tag tag--magenta">{t}</li>)}
            </ul>
            <div class="links">
              {p.demo && (
                <a class="btn" href={p.demo} rel="noopener">
                  Launch live site ↗
                </a>
              )}
              {p.repo && (
                <a class="btn btn--magenta" href={p.repo} rel="noopener">
                  View source
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }

    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((p) => (
            <article class="card panel">
              <span class:list={['tag', statusLabel[p.status].cls]}>{statusLabel[p.status].text}</span>
              <h2 class="card__name">{p.name}</h2>
              <p class="card__summary">{p.summary}</p>
              <ul class="card__details">
                {p.details.map((d) => <li>{d}</li>)}
              </ul>
              <ul class="stack" aria-label="Tech used">
                {p.tech.map((t) => <li class="tag tag--magenta">{t}</li>)}
              </ul>
              <div class="links">
                {p.demo && <a class="btn" href={p.demo} rel="noopener">Live ↗</a>}
                {p.repo && <a class="btn btn--magenta" href={p.repo} rel="noopener">Source</a>}
              </div>
            </article>
          ))}
        </div>
      )
    }

    <p class="more">
      <span class="more__prompt">$</span> more on <a href="https://github.com/InTheHiggsField">github.com/InTheHiggsField</a>
    </p>
  </section>
</Base>

<style>
  .projects {
    display: grid;
    gap: 24px;
  }
  .feat {
    padding: 0;
  }
  .feat__bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 18px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    border-bottom: 1px solid rgba(0, 240, 255, 0.18);
    background: rgba(255, 255, 255, 0.03);
  }
  .feat__bar span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .feat__bar span:last-child {
    color: var(--neon-yellow);
    text-transform: uppercase;
  }
  .feat__body {
    padding: clamp(20px, 4vw, 36px);
  }
  .feat__name {
    margin: 14px 0 8px;
    font-size: clamp(1.4rem, 4.5vw, 2.4rem);
    overflow-wrap: anywhere;
  }
  .feat__summary {
    margin: 0 0 18px;
    font-size: 1.15rem;
    color: #fff;
    max-width: 60ch;
  }
  .feat__details,
  .card__details {
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    color: var(--text-muted);
    max-width: 72ch;
  }
  .feat__details li,
  .card__details li {
    position: relative;
    padding-left: 22px;
  }
  .feat__details li::before,
  .card__details li::before {
    content: '>';
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    color: var(--neon-cyan);
  }
  .stack {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
  }
  .card > .tag {
    align-self: flex-start;
  }
  .card__name {
    margin: 12px 0 6px;
    font-size: 1.2rem;
    overflow-wrap: anywhere;
  }
  .card__summary {
    margin: 0 0 14px;
    color: #fff;
  }
  .card__details {
    font-size: 0.95rem;
    flex: 1;
  }
  .card .btn {
    padding: 8px 14px;
    font-size: 0.8rem;
  }
  .more {
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .more__prompt {
    color: var(--neon-magenta);
  }
</style>
